# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]?schema=public
DATABASE_URL="postgresql://username:password@localhost:5432/taskflow?schema=public"

# Authentication Secrets (Generate a strong random string in production)
JWT_SECRET="your_jwt_secret_key_change_me_in_production"
JWT_EXPIRES_IN="7d"

# CORS Security (Comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:5173"
